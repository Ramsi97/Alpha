{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AlphaGo game manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug", "version", "title", "description", "category", "thumbnail",
    "entry", "orientation", "score", "xp", "license", "size_kb", "status"
  ],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "title": { "$ref": "#/definitions/localizedString" },
    "description": { "$ref": "#/definitions/localizedString" },
    "category": {
      "type": "string",
      "enum": ["puzzle", "logic", "memory", "strategy", "word", "arcade", "number-puzzle", "binary-logic", "reflex-arcade"]
    },
    "thumbnail": { "type": "string" },
    "entry": { "type": "string" },
    "orientation": { "type": "string", "enum": ["portrait", "landscape", "any"] },
    "variants": {
      "type": "array",
      "items": { "type": "string" }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "higher_is_better", "max_score", "min_play_seconds", "max_score_per_second"],
      "properties": {
        "mode": { "type": "string", "enum": ["bridge"] },
        "higher_is_better": { "type": "boolean" },
        "max_score": { "type": "number", "minimum": 0 },
        "min_play_seconds": { "type": "number", "minimum": 0 },
        "max_score_per_second": { "type": "number", "minimum": 0 }
      }
    },
    "xp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rate", "max_per_run"],
      "properties": {
        "rate": { "type": "number", "minimum": 0 },
        "max_per_run": { "type": "number", "minimum": 0 }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "assets", "author", "source_url"],
      "properties": {
        "code": { "type": "string" },
        "assets": { "type": "string" },
        "author": { "type": "string" },
        "source_url": { "type": "string", "format": "uri" }
      }
    },
    "size_kb": { "type": "number", "minimum": 0 },
    "status": { "type": "string", "enum": ["pending", "active", "disabled"] }
  },
  "definitions": {
    "localizedString": {
      "type": "object",
      "required": ["en"],
      "additionalProperties": { "type": "string" },
      "properties": { "en": { "type": "string" } }
    }
  }
}
