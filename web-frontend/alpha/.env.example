# Copy to .env.local (vite auto-loads it, gitignored) and adjust as needed.

# server/ API, prefix already includes /api/v1 in src/lib/api.ts
VITE_API_BASE_URL=http://localhost:8000

# Static origin serving games/ (see ../../games/README.md — e.g.
# `cd games && python3 -m http.server 8731`). Must match the backend's
# GAMES_ORIGIN so entry_url values returned by GET /games resolve.
VITE_GAMES_BASE_URL=http://localhost:8731
