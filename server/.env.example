# Copy to .env and fill in real values. Never commit the real .env.

# development (default) | staging | production. Only gates one startup
# check today (app/main.py refuses to boot with the default insecure
# JWT_SECRET when this is "production") but set it correctly regardless.
ENVIRONMENT=development

# Telegram
BOT_TOKEN=
BOT_USERNAME=
MINI_APP_SHORT_NAME=play
WEBHOOK_URL=
WEBHOOK_SECRET=

# Infra
DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/alphago
# Sized from the load test in server/README.md's B6 section — a single
# API process needs a wide-enough pool, but also needs to run as
# multiple worker processes (`uvicorn --workers N`) to actually use it;
# see that section before assuming raising these two numbers alone fixes
# a latency problem.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
# Real Redis in any environment that has one. "fakeredis://" is a sentinel
# this codebase recognizes to fall back to an in-memory substitute for
# local dev environments with no Redis available — see app/core/redis.py.
REDIS_URL=redis://redis:6379/0

# Auth
JWT_SECRET=
JWT_TTL_SECONDS=3600
INITDATA_MAX_AGE_SECONDS=86400

# CORS / iframe origins
APP_ORIGIN=https://app.yourdomain.com
GAMES_ORIGIN=https://games.yourdomain.com

# Admin bootstrap (comma-separated Telegram user ids)
ADMIN_TELEGRAM_IDS=

# Observability
SENTRY_DSN=

# Notifications
NOTIFY_RATE_PER_SECOND=25

# Share / score cards
PUBLIC_BASE_URL=https://api.yourdomain.com
MEDIA_DIR=media
